{
    "type": "module",
    "private": true,
    "workspaces": [
        "src/*",
        "tests/*"
    ],
    "scripts": {
        "start": "npm run start --workspace @forma/app",
        "build": "npm run build --workspace @forma/app",
        "preview": "npm run preview --workspace @forma/app",
        "clean": "dotnet fable clean --yes",
        "test": "npm run test --workspaces --if-present"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.5.1",
        "@uiw/color-convert": "^1.3.3",
        "@uiw/react-color-colorful": "^1.3.3",
        "bulma": "^1.0.4",
        "monaco-editor": "^0.41.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.1.1",
        "mocha": "^10.2.0",
        "sass": "^1.94.2",
        "vite": "^8.2.2"
    },
    "allowScripts": {
        "esbuild": true,
        "@parcel/watcher": true
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
